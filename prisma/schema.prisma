generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma/client"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Session {
  id              String           @id
  status          String           @default("close")
  webhookUrl      String?          @map("webhook_url")
  userJid         String?          @map("user_jid")
  userName        String?          @map("user_name")
  retryCount      Int              @default(0) @map("retry_count")
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  authCredentials AuthCredential[]
  chats           Chat[]
  contacts        Contact[]
  messages        Message[]
  webhookLogs     WebhookLog[]
  groups          Group[]
  webhooks        Webhook[]
  sessionEvents   SessionEvent[]
  auditLogs       AuditLog[]

  @@map("sessions")
}

model AuthCredential {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  type      String
  keyId     String   @map("key_id")
  data      String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, type, keyId])
  @@index([sessionId])
  @@map("auth_credentials")
}

model Message {
  id           String   @id @default(cuid())
  sessionId    String   @map("session_id")
  remoteJid    String   @map("remote_jid")
  messageId    String   @map("message_id")
  fromMe       Boolean  @default(false) @map("from_me")
  participant  String?
  pushName     String?  @map("push_name")
  messageType  String?  @map("message_type")
  content      Json
  contextInfo  Json?    @map("context_info")
  status       String   @default("pending")
  timestamp    DateTime
  createdAt    DateTime @default(now()) @map("created_at")
  session      Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, remoteJid, messageId])
  @@index([sessionId, remoteJid])
  @@index([sessionId, timestamp])
  @@index([createdAt])
  @@index([sessionId, status])
  @@map("messages")
}

model Contact {
  id               String   @id @default(cuid())
  sessionId        String   @map("session_id")
  jid              String
  name             String?
  notify           String?
  imgUrl           String?  @map("profile_picture_url")
  pushName         String?  @map("push_name")
  status           String?
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  session          Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
  @@index([sessionId])
  @@map("contacts")
}

model Chat {
  id                    String   @id @default(cuid())
  sessionId             String   @map("session_id")
  jid                   String
  name                  String?
  conversationTimestamp BigInt?  @map("conversation_timestamp")
  unreadCount           Int      @default(0) @map("unread_count")
  archived              Boolean  @default(false)
  pinned                Boolean  @default(false)
  muted                 Boolean  @default(false)
  muteEndTime           BigInt?  @map("mute_end_time")
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")
  session               Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, jid])
  @@index([sessionId])
  @@map("chats")
}

model WebhookLog {
  id         String   @id @default(cuid())
  sessionId  String   @map("session_id")
  event      String
  url        String
  payload    Json
  statusCode Int?     @map("status_code")
  response   String?
  attempts   Int      @default(1)
  success    Boolean  @default(false)
  error      String?
  createdAt  DateTime @default(now()) @map("created_at")
  session    Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([createdAt])
  @@index([success])
  @@map("webhook_logs")
}

model Group {
  id          String   @id @default(cuid())
  sessionId   String   @map("session_id")
  jid         String   @unique @map("group_jid")
  subject     String?
  description  String?  @map("group_description")
  ownerJid    String?  @map("owner_jid")
  participants Json    @default("[]")
  settings    Json     @default("{}")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")
  session     Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@map("groups")
}

model Webhook {
  id        String   @id @default(cuid())
  sessionId String   @map("session_id")
  name      String
  url       String
  secret    String?
  events    String[] @default([])
  headers   Json     @default("{}")
  active    Boolean  @default(true)
  maxRetries Int     @default(3) @map("max_retries")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
  @@index([active])
  @@map("webhooks")
}

model SessionEvent {
  id            String   @id @default(cuid())
  sessionId     String   @map("session_id")
  eventType     String   @map("event_type")
  payload       Json
  sequenceNumber BigInt  @default(0) @map("sequence_number")
  createdAt     DateTime @default(now()) @map("created_at")
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, sequenceNumber])
  @@index([sessionId, eventType])
  @@map("session_events")
}

model AuditLog {
  id           String   @id @default(cuid())
  sessionId    String?  @map("session_id")
  userId       String?  @map("user_id")
  action       String
  resourceType String   @map("resource_type")
  resourceId   String?  @map("resource_id")
  metadata     Json?
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  createdAt    DateTime @default(now()) @map("created_at")
  session      Session? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([sessionId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  id          String   @id @default(cuid())
  key         String   @unique
  response    Json?
  statusCode  Int      @default(0) @map("status_code")
  expiresAt   DateTime @map("expires_at")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}
